# ==========================================
# OpenAI Configuration (required)
# ==========================================
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7

# ==========================================
# OpenRouteService Configuration (required)
# ==========================================
ORS_API_KEY=your-ors-key-here

# ==========================================
# Application Settings (optional)
# ==========================================
DEBUG=true

# ==========================================
# Agent Settings (optional)
# ==========================================
AGENT_TIMEOUT=120
MAX_RETRIES=3

# ==========================================
# Observability (Phase 12, all optional — the app runs exactly as before
# with none of this set)
# ==========================================

# OpenTelemetry: turns on real span creation (FastAPI/SQLAlchemy/requests
# auto-instrumentation + custom agent/LLM spans) and writes them to the
# `spans` table so the Observability UI has real telemetry to read. Runs
# fully local with no other vars set below — nothing external is required.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=voyager-ai
OTEL_ENVIRONMENT=development
# Point this at an OTLP collector (e.g. http://localhost:4318) to also
# export spans externally. Leave unset to keep tracing fully local.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_SAMPLER=always_on
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_CAPTURE_CONTENT=true

# LangSmith: these are LangSmith's own env var names (not Voyager-specific) —
# LangChain/LangGraph read them directly and trace automatically once set,
# with no other code changes. Get a free API key at smith.langchain.com →
# Settings → API Keys.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=voyager-ai

# Arize Phoenix: run it as its own container (docker-compose.yml's `phoenix`
# service) or a separate local process — never pip-install arize-phoenix
# into this app's own venv (its dependency chain conflicts with crewai's
# openai<3 pin and app/mcp_server.py's mcp<2 pin; see requirements.txt).
# Voyager only ever talks to it over plain OTLP/HTTP.
PHOENIX_ENABLED=false
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=voyager-ai
