# ==========================================
# OpenAI Configuration (required)
# ==========================================
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7

# ==========================================
# OpenRouteService Configuration (required)
# ==========================================
ORS_API_KEY=your-ors-key-here

# ==========================================
# Database (optional — defaults to SQLite)
# ==========================================
# DATABASE_URL=postgresql://user:pass@localhost:5432/voyager

# ==========================================
# Application Settings
# ==========================================
DEBUG=false
AGENT_TIMEOUT=120
MAX_RETRIES=3

# ==========================================
# CORS — must be the frontend's real HTTPS origin in production
# ==========================================
CORS_ORIGINS=https://voyager-ai.adityajagtap.com,http://localhost:5173

# ==========================================
# Observability (all optional)
# ==========================================
OTEL_ENABLED=false
OTEL_SERVICE_NAME=voyager-ai
OTEL_ENVIRONMENT=production
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_SAMPLER=always_on
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_CAPTURE_CONTENT=true

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=voyager-ai

PHOENIX_ENABLED=false
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=voyager-ai
PHOENIX_API_KEY=
